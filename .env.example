# ==============================================================================
# TIENDA TIGRE - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como .env.local para desarrollo local o configura estas
# variables en el panel de Vercel para producción.
#
# NOTA ARQUITECTÓNICA:
# La aplicación cuenta con un motor Híbrido Offline-First (Supabase + IndexedDB).
# Si no se configuran las credenciales de Supabase aún, la app inicia
# automáticamente en Modo Local Sincronizado con los datos semilla mexicanos
# precargados en IndexedDB, permitiendo usar el POS, escáner, inventario,
# reportes e impresora térmica de inmediato.
# ==============================================================================

# 1. Credenciales públicas de tu proyecto en Supabase (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Clave de servicio de Supabase (Opcional - solo para respaldos administrativos server-side)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Configuración predeterminada de la Sucursal y Tienda (México - MXN)
NEXT_PUBLIC_STORE_NAME="Abarrotes El Tigre"
NEXT_PUBLIC_DEFAULT_BRANCH_CODE="MATRIZ"
NEXT_PUBLIC_CURRENCY="MXN"
NEXT_PUBLIC_LOCALE="es-MX"

# 4. API externa para autocompletar productos por código de barras (Open Food Facts)
NEXT_PUBLIC_OPEN_FOOD_FACTS_API="https://world.openfoodfacts.org/api/v2/product"
